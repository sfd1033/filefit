{
  "name": "filefit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare.mjs && next dev --webpack",
    "build": "node scripts/prepare.mjs && next build --webpack && node scripts/csp.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
