# Optional during preview: leave unset to keep noindex / robots Disallow.
# Set the real public origin in Cloudflare Pages Production before rebuilding.
# Enable indexing only after operator/contact/privacy details are complete.
# NEXT_PUBLIC_ALLOW_INDEXING=true
# NEXT_PUBLIC_SITE_URL=https://your-project.pages.dev
# NEXT_PUBLIC_CONTACT_EMAIL=your-public-contact-address
NEXT_TELEMETRY_DISABLED=1
